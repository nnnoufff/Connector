# Copy this file to .env.local and fill in your own keys. Never commit real keys.

# DeepL (optional, best translation quality). Server-side only: used by the Vite dev proxy / a serverless function.
DEEPL_API_KEY=

# Google Cloud Translation (optional fallback). VITE_ variables are visible in the browser, so restrict the key by domain.
VITE_GOOGLE_TRANSLATE_KEY=
